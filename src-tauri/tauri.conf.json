{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDI Developer Journal",
  "mainBinaryName": "EDI Developer Journal",
  "version": "0.1.1",
  "identifier": "com.techghoust.edi-developer-journal",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../apps/desktop/dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EDI Developer Journal",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "maximized": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
